# What the published file lacks: the suggested prefix of the ontology. Only metadata; never a new
# term (see README §The data).
@prefix vann: <http://purl.org/vocab/vann/> .

<http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    vann:preferredNamespacePrefix "rdf" ;
    vann:preferredNamespaceUri "http://www.w3.org/1999/02/22-rdf-syntax-ns#" .
