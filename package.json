{
  "name": "@_linked/rdfs",
  "displayName": "RDFS (RDF Schema)",
  "description": "RDF and RDFS vocabularies as ontologies plus the core @linkedShape classes Resource, Class and Property. Renamed from lincd-rdfs.",
  "version": "1.5.0",
  "license": "MIT",
  "files": [
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "packageManager": "npm@12.2.0",
  "linkedPackage": true,
  "linkedOntologies": {
    "rdf": {
      "namespace": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    },
    "rdfs": {
      "namespace": "http://www.w3.org/2000/01/rdf-schema#"
    }
  },
  "type": "module",
  "author": {
    "name": "René Verheij",
    "url": "https://github.com/flyon",
    "email": "rpwverheij@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/rdfs.git"
  },
  "keywords": [
    "linked",
    "linked code",
    "linked data",
    "semantic web",
    "rdf",
    "rdfs"
  ],
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "index.d.ts",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@_linked/core": "^2.41.0",
    "@_linked/react": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@_linked/cli": "^1.57.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
